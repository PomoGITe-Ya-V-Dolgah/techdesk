# Для разработки достаточно скопировать этот файл в .env.
# Для локальной сети удобнее создать .env командой: python deploy/make_env.py
DJANGO_SECRET_KEY=change-me
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=127.0.0.1,localhost,testserver
# Адреса, с которых открывают сайт (нужны при DJANGO_DEBUG=0), через запятую:
DJANGO_CSRF_TRUSTED_ORIGINS=
# Адрес сервера для QR-кодов, например http://192.168.1.10:8000
PUBLIC_BASE_URL=
# 1 — показывать демо-логины на странице входа
SHOW_DEMO_LOGINS=1
DJANGO_TIME_ZONE=Europe/Moscow
TECHDESK_HOST=0.0.0.0
TECHDESK_PORT=8000

# Почта для уведомлений (пусто — не отправлять)
EMAIL_HOST=
EMAIL_PORT=587
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
EMAIL_USE_TLS=1
DEFAULT_FROM_EMAIL=

# Защита входа и адрес админки
LOGIN_MAX_FAILURES=5
LOGIN_LOCKOUT_MINUTES=15
DJANGO_ADMIN_URL=admin/

# Доступ из интернета через Caddy (см. docs/deploy/INTERNET.md)
TECHDESK_DOMAIN=
DJANGO_HTTPS=0
BEHIND_PROXY=0

# If POSTGRES_DB is empty, Django uses local SQLite for quick development.
POSTGRES_DB=
POSTGRES_USER=servicedesk
POSTGRES_PASSWORD=servicedesk
POSTGRES_HOST=127.0.0.1
POSTGRES_PORT=5432
